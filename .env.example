# Copy this file to .env.local and use your Supabase project's values.
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the anon key (or publishable key), never a service_role/secret key.
SUPABASE_ANON_KEY=your-anon-key

# Server-only Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: choose a model available to your Gemini API project.
GEMINI_MODEL=gemini-3.5-flash
